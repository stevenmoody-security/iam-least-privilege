{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDevBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::stevenmoody-awslab-dev"
    },
    {
      "Sid": "ReadWriteDevObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::stevenmoody-awslab-dev/*"
    }
  ]
}